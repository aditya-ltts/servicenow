var emp = producer.employee;
var period = producer.review_period;
var empScore = producer.self_review;
var mgrScore = producer.manager_score;
var total = (empScore * 0.4) + (mgrScore * 0.6);
// current.rating = total;
var gr = new GlideRecord('x_594089_employe_0_performance_review');
gr.addQuery('employee', emp);
gr.addQuery('review_period', period);
gr.query();

if (gr.next()) {
    gr.manager_review = producer.manager_review;
    gr.manager_score = producer.manager_score;
	gr.rating = total;
    gr.update();
    gs.addInfoMessage("Review updated successfully for " + gr.employee.getDisplayValue());
    current.setAbortAction(true);
} else {
    gs.addErrorMessage("No self-review found for selected employee and review period.");
    current.setAbortAction(true);
}
var page = '/sp?id=success_message';
var widgetId = '8b58644f476f2210cec2cd9fe16d4310';
var type = 'performance';
var recordId = current.sys_id.toString();

producer.portal_redirect = 'https://dev296024.service-now.com/' + page +
    '&sys_id=' + widgetId +
    '&type=' + type +
    '&record_id=' + recordId;]]></script>
